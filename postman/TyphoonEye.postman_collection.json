{
  "info": {
    "_postman_id": "6ce3304f-d208-49a2-84f0-09c5be542672",
    "name": "Typhoon Eye",
    "description": "TyphoonEye API smoke tests. Put secrets in the environment file — never hardcode keys.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{JWT_key}}", "type": "string" }]
  },
  "variable": [
    { "key": "api_host", "value": "https://devapi.qweather.com" },
    { "key": "JWT_key", "value": "", "type": "secret" },
    { "key": "JUHE_KEY", "value": "" },
    { "key": "TFID", "value": "" },
    { "key": "STORM_ID", "value": "" },
    { "key": "YEAR", "value": "2026" }
  ],
  "item": [
    {
      "name": "聚合台风列表",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded", "type": "text" }
        ],
        "url": {
          "raw": "https://apis.juhe.cn/fapigw/typhoon/active?key={{JUHE_KEY}}",
          "protocol": "https",
          "host": ["apis", "juhe", "cn"],
          "path": ["fapigw", "typhoon", "active"],
          "query": [{ "key": "key", "value": "{{JUHE_KEY}}" }]
        }
      }
    },
    {
      "name": "聚合台风实时路径",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded", "type": "text" }
        ],
        "url": {
          "raw": "https://apis.juhe.cn/fapigw/typhoon/detail?key={{JUHE_KEY}}&tfid={{TFID}}",
          "protocol": "https",
          "host": ["apis", "juhe", "cn"],
          "path": ["fapigw", "typhoon", "detail"],
          "query": [
            { "key": "key", "value": "{{JUHE_KEY}}" },
            { "key": "tfid", "value": "{{TFID}}" }
          ]
        }
      }
    },
    {
      "name": "和风天气台风查询",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_host}}/v7/tropical/storm-list?basin=NP&year={{YEAR}}",
          "host": ["{{api_host}}"],
          "path": ["v7", "tropical", "storm-list"],
          "query": [
            { "key": "basin", "value": "NP" },
            { "key": "year", "value": "{{YEAR}}" }
          ]
        }
      }
    },
    {
      "name": "和风台风预报",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_host}}/v7/tropical/storm-forecast?stormid={{STORM_ID}}",
          "host": ["{{api_host}}"],
          "path": ["v7", "tropical", "storm-forecast"],
          "query": [{ "key": "stormid", "value": "{{STORM_ID}}" }]
        }
      }
    },
    {
      "name": "和风台风路径",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_host}}/v7/tropical/storm-track?stormid={{STORM_ID}}",
          "host": ["{{api_host}}"],
          "path": ["v7", "tropical", "storm-track"],
          "query": [{ "key": "stormid", "value": "{{STORM_ID}}" }]
        }
      }
    }
  ]
}
