## Typhoon Eye — local.properties 示例
#
# 对齐 Postman Collection「Typhoon Eye」
# https://go.postman.co/collection/19016561-6ce3304f-d208-49a2-84f0-09c5be542672
#
# 复制到项目根目录 local.properties（已被 gitignore）。

# sdk.dir=/Users/YOU/Library/Android/sdk

# ---------- Juhe（Postman：聚合台风列表 / 聚合台风实时路径）----------
# GET https://apis.juhe.cn/fapigw/typhoon/active?key=...
# GET https://apis.juhe.cn/fapigw/typhoon/detail?key=...&tfid=...
JUHE_KEY=your_juhe_api_key_here

# ---------- QWeather（Postman：和风天气台风查询 / 预报 / 路径）----------
# Collection 级 Auth: Bearer {{JWT_key}}
# Collection 变量: api_host, JWT_key (secret)
#
# GET {{api_host}}/v7/tropical/storm-list?basin=NP&year=2026
# GET {{api_host}}/v7/tropical/storm-forecast?stormid=NP_2609
# GET {{api_host}}/v7/tropical/storm-track?stormid=NP_2609

QWEATHER_HOST=https://pu6yvrgfbv.re.qweatherapi.com/

# 方式 A（推荐）：控制台 API KEY → Header X-QW-Api-Key
QWEATHER_API_KEY=your_qweather_api_key_here

# 方式 B：EdDSA JWT（kid + projectId + 私钥 PEM）
# QWEATHER_KID=your_credential_id
# QWEATHER_PROJECT_ID=your_project_id
# QWEATHER_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ---------- 地图底图（可选）----------
# 默认使用 app/src/main/assets/map_style.json（Carto Voyager 栅格，无需 Key）
# MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json
